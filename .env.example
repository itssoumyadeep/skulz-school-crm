# Copy to .env for local development. Replace every replace-me placeholder.
# Do not commit .env, local.env, or real credentials.

DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-me-with-python-secrets-token-url-safe-64
JWT_SECRET_KEY=replace-me-with-a-different-python-secrets-token-url-safe-64
ALLOW_INSECURE_DEV_TOKENS=false

DB_ENGINE=django.db.backends.postgresql
DB_NAME=skool_crm_db
DB_USER=postgres
DB_PASSWORD=replace-me-with-your-local-postgres-password
DB_HOST=127.0.0.1
DB_PORT=5432
DB_CONN_MAX_AGE=0

DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SECURE_HSTS_SECONDS=0

FRONTEND_BASE_URL=http://localhost:3000
STRIPE_SECRET_KEY=sk_test_replace-me
STRIPE_WEBHOOK_SECRET=whsec_replace-me
STRIPE_CURRENCY=cad